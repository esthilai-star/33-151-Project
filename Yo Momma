   "metadata": {},
   "outputs": [],
   "source": [
    "WallL = box(pos=vector(-10,0,0),size=vector(.2,20,5),color=color.red)\n",
    "WallR = box(pos=vector(10,0,0),size=vector(.2,20,5),color=color.red)\n",
    "Wall_top = box(pos=vector(0,10,0),size=vector(20,.2,5),color=color.red)\n",
    "Wall_bottom = box(pos=vector(0,-10,0),size=vector(20,.2,5),color=color.red)\n",
    "#\n",
    "MOF = sphere(pos=vector(0,0,0),radius=1,color=color.red)\n",
    "C1 = sphere(pos=vector(5,2,0),radius=.25,color=color.cyan)\n",
    "C2 = sphere(pos=vector(3,-5,0),radius=.25,color=color.cyan)\n",
    "C3 = sphere(pos=vector(-5,0,0),radius=.25,color=color.cyan)\n",
    "C4 = sphere(pos=vector(-1,-5,0),radius=.25,color=color.cyan)\n",
    "C5 = sphere(pos=vector(8,7,0),radius=.25,color=color.cyan)\n",
    "C6 = sphere(pos=vector(0,8,0),radius=.25,color=color.cyan)\n",
    "#\n",
    "C1.velocity = vector(1,0.1,0)\n",
    "#\n",
    "t = 0\n",
    "dt = 0.1\n",
    "#\n",
    "while t<1000:\n",
    "    rate(100)\n",
    "    if C1.visible:\n",
    "        C1.pos = C1.pos + C1.velocity*dt\n",
    "    if C1.pos.x < WallL.pos.x:\n",
    "        C1.velocity.x = -C1.velocity.x\n",
    "    if C1.pos.x > WallR.pos.x:\n",
    "        C1.velocity.x = -C1.velocity.x\n",
    "    if C1.pos.y > Wall_top.pos.y:\n",
    "        C1.velocity.y = -C1.velocity.y\n",
    "    if C1.pos.y < Wall_bottom.pos.y:\n",
    "        C1.velocity.y = -C1.velocity.y\n",
    "    if C1.pos.y < MOF.pos.y:\n",
    "        C1.visible = False\n",
    "#\n",
    "    t = t+dt"
   ]
